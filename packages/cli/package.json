{
  "name": "depmod-ui",
  "version": "0.4.4",
  "description": "Visualise the dependency graph of a JavaScript / TypeScript project from your terminal.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "depmod-ui": "dist/index.js"
  },
  "files": ["dist", "web", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "prepare-package": "node scripts/prepare-package.mjs",
    "prepack": "pnpm run build && pnpm run prepare-package",
    "prepublishOnly": "pnpm -w run build && pnpm -w run typecheck && pnpm -w run test",
    "test": "vitest run --passWithNoTests"
  },
  "keywords": [
    "dependency",
    "dependencies",
    "module",
    "modules",
    "graph",
    "visualization",
    "visualisation",
    "typescript",
    "javascript",
    "react",
    "next",
    "monorepo",
    "architecture",
    "static-analysis",
    "depmod"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EduardLupu/depmod.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/EduardLupu/depmod#readme",
  "bugs": {
    "url": "https://github.com/EduardLupu/depmod/issues"
  },
  "author": "Eduard Lupu",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "ignore": "^7.0.0",
    "kleur": "^4.1.5",
    "next": "15.5.18",
    "picomatch": "^4.0.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.34.0",
    "ts-morph": "^24.0.0",
    "typescript": "^5.6.3",
    "update-notifier": "^7.3.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@depmod/parser": "workspace:*",
    "@depmod/types": "workspace:*",
    "@types/node": "^22.7.5",
    "@types/update-notifier": "^6.0.8",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
