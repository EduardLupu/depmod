{
  "name": "depmod-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "build": "pnpm --filter @depmod/types build && pnpm --filter @depmod/parser build && pnpm --filter web build && pnpm --filter depmod-ui build",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "depmod-ui": "depmod-ui",
    "bench": "pnpm --filter @depmod/bench bench",
    "changeset": "changeset",
    "changeset:version": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.10",
    "depmod-ui": "workspace:*",
    "typescript": "^5.6.3"
  }
}
