{
  "name": "depmod-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "build": "pnpm --filter @depmod/types build && pnpm --filter @depmod/parser build && pnpm --filter web build && pnpm --filter depmod-ui build",
    "build:internals": "pnpm --filter @depmod/types build && pnpm --filter @depmod/parser build",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "depmod-ui": "depmod-ui",
    "bench": "pnpm --filter @depmod/bench bench",
    "bench:quick": "pnpm --filter @depmod/bench bench:quick",
    "bench:list": "pnpm --filter @depmod/bench bench:list",
    "changeset": "changeset",
    "changeset:version": "changeset version && biome check --write --no-errors-on-unmatched --files-ignore-unknown=true .",
    "format:fix": "biome check --write .",
    "format:check": "biome check .",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec biome check --no-errors-on-unmatched --files-ignore-unknown=true . || { echo ''; echo '  Biome formatting check failed. Run \\`pnpm format:fix\\` and re-stage.' >&2; echo ''; exit 1; }"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.10",
    "depmod-ui": "workspace:*",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.6.3"
  }
}
